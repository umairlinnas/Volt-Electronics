rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products: readable by everyone, writeable for management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders: readable by order tracker or customer, createable on checkout
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if true;
    }
    
    // Promotional Offers & Coupons: readable by shoppers, modifiable by staff
    match /offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Staff & Administrators
    match /staff/{staffId} {
      allow read, write: if true;
    }
    
    // Store Notifications & Activity Logs
    match /notifications/{notifId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
